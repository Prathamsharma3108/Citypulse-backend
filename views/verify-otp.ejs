<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Verify OTP - City Pulse</title>
    <link rel="stylesheet" href="/css/style.css"> 
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700&display=swap" rel="stylesheet">
</head>
<body>
    <div class="container">
        <h1 class="brand-title">Check Your Email</h1>
        <p>We sent a 6-digit One-Time Password (OTP) to <br><strong style="color: var(--primary);"><%= email %></strong>.</p>

        <div class="form-container">
            <% if (locals.error && error) { %>
                <div class="error-message"><%= error %></div>
            <% } %>

            <form action="/auth/verify-otp" method="POST">
                <div class="form-group">
                    <label for="otp">Enter 6-Digit Code</label>
                    <input type="text" id="otp" name="otp" required pattern="\d{6}" title="Please enter a 6-digit number" placeholder="000000" style="text-align: center; font-size: 1.5rem; letter-spacing: 0.5rem;">
                </div>
                
                <button type="submit" class="button">Verify & Login</button>
            </form>
            <div class="form-links">
                <p>Didn't get an email? <a href="/auth/login">Go back to login</a></p>
            </div>
        </div>
    </div>
</body>
</html>